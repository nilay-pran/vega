<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="uploader-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\Times Internet\Slike Uploader">
    </Installer>
    <PackageInformation
        PackageName="Slike Uploader"
        PackageDisplayName="Slike Uploader"
        PublisherName="CN=Times Internet"
        PublisherDisplayName="Times Internet"
        Version="0.1.0.0"
        PackageDescription="Desktop uploader for the Slike Video CMS">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="ke.sli.slike.uploader"
                Description="Desktop uploader for the Slike Video CMS"
                DisplayName="Slike Uploader"
                ExecutableName="uploader-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Slike Uploader</DisplayName>
            <PublisherDisplayName>Times Internet</PublisherDisplayName>
            <Description>Desktop uploader for the Slike Video CMS</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="uploader-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
